{
  "expo": {
    "name": "Angel Artic",
    "slug": "angel-artic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Angel Artic listens to your child say practice words. Recordings stay on this device.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.angelartic.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B655D0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "package": "com.angelartic.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Angel Artic listens to your child say practice words. Recordings stay on this device."
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Angel Artic lets a parent add a photo to a custom practice word."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#B655D0",
          "imageWidth": 220
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "backgroundColor": "#FFF9F0",
    "description": "Gentle speech sound practice for kids. Recordings stay on the device."
  }
}